rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any signed-in user can read profiles (needed for username lookup).
    // Only the owner can write their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Clips: public documents are readable by the app. Owners control content
    // and visibility; other signed-in listeners may only move public counters
    // by one step, never rewrite clip metadata or force a negative count.
    match /clips/{clipId} {
      allow read: if resource.data.isPublic == true ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isPublic', 'updatedAt', 'createdBy', 'title', 'artist', 'loops',
            'youtubeVideoId', 'startTime', 'endTime', 'loopCount'
          ])
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes >= 0 &&
          (
            request.resource.data.likes == resource.data.get('likes', 0) + 1 ||
            request.resource.data.likes == resource.data.get('likes', 0) - 1
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays']) &&
          request.resource.data.plays == resource.data.get('plays', 0) + 1
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares']) &&
          request.resource.data.shares == resource.data.get('shares', 0) + 1
        )
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Playlists: discovery can read public playlists; private playlists remain
    // visible only to their owner. Only the declared owner may create or mutate.
    match /playlists/{playlistId} {
      allow read: if resource.data.isPublic == true ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Payments: only owner can read/write their payment records.
    match /payments/{paymentId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }

    // UserLikes: each user owns their own likes document.
    match /userLikes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Friendships: either participant can read. The sender can create a pending
    // request, but only the recipient can accept or decline it, without rewriting
    // either participant or the original request metadata.
    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.participants.hasAll([
          request.resource.data.fromUid,
          request.resource.data.toUid
        ]);
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.toUid &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'declined'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'respondedAt'
        ]);
    }
  }
}
